# ─────────────────────────────────────────────────────────────────────────────
# DOCE SABOR FIDELIDADE — Variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA versione .env.local ou qualquer arquivo com valores reais.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Supabase ────────────────────────────────────────────────────────────────
# Obter em: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Apenas em Edge Functions / rotas de servidor — NUNCA no cliente
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Banco (conexão direta para migrations) ───────────────────────────────────
DATABASE_URL=postgresql://postgres:[SENHA]@db.SEU_PROJECT_REF.supabase.co:5432/postgres

# ─── Auth / JWT ──────────────────────────────────────────────────────────────
SUPABASE_JWT_SECRET=seu-jwt-secret-aqui

# ─── Tokens internos ─────────────────────────────────────────────────────────
# Chave para assinar tokens de resgate (mínimo 32 bytes, aleatório)
REDEMPTION_TOKEN_SECRET=gere-com-openssl-rand-base64-32

# Chave para assinar QR de identificação do cliente
CUSTOMER_QR_SECRET=gere-com-openssl-rand-base64-32

# ─── OTP / Verificação ───────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ─── NFC-e / Fiscal ──────────────────────────────────────────────────────────
# CNPJ da loja emitente (sem formatação)
STORE_CNPJ=02982922000177

# CSC para validação de QR NFC-e (NUNCA no cliente — apenas Edge Functions)
NFCE_CSC_ID=000001
NFCE_CSC_TOKEN=seu-csc-secreto-aqui

# Ambiente fiscal: homologacao | producao
NFCE_AMBIENTE=homologacao

# URL do provedor fiscal autorizado
NFCE_PROVIDER_URL=https://seu-provedor-fiscal.com.br/api

# Timeout da consulta fiscal (ms)
NFCE_TIMEOUT_MS=8000

# Idade máxima da nota para aceite (horas)
NFCE_MAX_AGE_HOURS=72

# ─── Cron / Jobs ─────────────────────────────────────────────────────────────
# Secret para autenticar chamadas do cron Supabase → Edge Functions
CRON_SECRET=gere-com-openssl-rand-base64-32

# ─── URL Pública ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── E-mail (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@docesabor.com.br
RESEND_FROM_NAME=Doce Sabor Fidelidade

# ─── Firebase (FCM Push) ─────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=doce-sabor-fidelidade
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@doce-sabor-fidelidade.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── WhatsApp Cloud API (Meta) ───────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=seu-phone-number-id
WHATSAPP_ACCESS_TOKEN=seu-access-token
WHATSAPP_VERIFY_TOKEN=seu-verify-token

# ─── Meta / Instagram ────────────────────────────────────────────────────────
META_APP_ID=seu-app-id
META_APP_SECRET=seu-app-secret
META_PAGE_ACCESS_TOKEN=seu-page-token
NEXT_PUBLIC_INSTAGRAM_HANDLE=docesaborcolatina

# ─── Upstash Redis (Rate limiting) ───────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=seu-token-upstash

# ─── Sentry (Observabilidade) ────────────────────────────────────────────────
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ORG=sua-org
SENTRY_PROJECT=doce-sabor-fidelidade
SENTRY_AUTH_TOKEN=seu-auth-token

# ─── Marca (valores que aparecem na UI, não são secrets) ─────────────────────
NEXT_PUBLIC_BRAND_NAME=Doce Sabor
NEXT_PUBLIC_BRAND_TAGLINE=Sorvetes Soft
NEXT_PUBLIC_BRAND_INSTAGRAM=https://www.instagram.com/docesaborcolatina/
NEXT_PUBLIC_STORE_CITY=Colatina
NEXT_PUBLIC_STORE_STATE=ES
NEXT_PUBLIC_STORE_CNPJ_FORMATTED=02.982.922/0001-77
